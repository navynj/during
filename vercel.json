{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm verify && next build",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.during.today" }],
      "destination": "https://during.today/$1",
      "permanent": true
    }
  ]
}
