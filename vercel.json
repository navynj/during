{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm verify && next build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www\\.(?<apex>.*)" }],
      "destination": "https://:apex/:path*",
      "permanent": true
    }
  ]
}
