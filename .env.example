# Local Supabase. `supabase start` prints these; the anon key is the same for
# every local stack, so these defaults work out of the box.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth (SPEC 9: auth is social login).
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI for local dev: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Service-role key, local only. Used by the RLS test to seed fixtures; never
# imported by app code and never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The canonical origin. Every OAuth return URL is built from this, and it must
# match an entry in supabase/config.toml additional_redirect_urls exactly.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
