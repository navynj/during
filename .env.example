# Local Supabase. `supabase start` prints these; the anon key is the same for
# every local stack, so these defaults work out of the box.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth (SPEC 9: auth is social login).
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI for local dev: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Service-role key: server-only, never shipped to the browser. The private
# media bucket needs it — the service role signs photo URLs after the viewer's
# session passes RLS (lib/media.ts) and removes objects on delete. Read only
# through lib/env.ts; the RLS test also uses it to seed fixtures.
SUPABASE_SERVICE_ROLE_KEY=

# The canonical origin. Every OAuth return URL is built from this, and it must
# match an entry in supabase/config.toml additional_redirect_urls exactly.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Production (Vercel) takes exactly four. instrumentation.ts checks them at
# server startup and fails with "Missing <NAME>" if one is absent.
#
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<the project's anon key>
#   NEXT_PUBLIC_SITE_URL=https://during.today
#   SUPABASE_SERVICE_ROLE_KEY=<the project's service role key>   (server-only, Sensitive)
#
# The Google credentials NEVER reach Vercel: they configure the LOCAL Supabase
# stack, and in cloud they live in the Supabase dashboard instead.
# See _docs/DEPLOY.md § 4.
